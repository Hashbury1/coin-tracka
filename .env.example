# --- Database ---
POSTGRES_USER=meme_admin
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=meme_tracker
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://meme_admin:change_me_locally@timescaledb:5432/meme_tracker

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_STREAM_NAME=raw_ticks

# --- External APIs ---
# Free tier works without a key (lower rate limit). Add a key for higher limits.
COINGECKO_API_KEY=
DEXSCREENER_BASE_URL=https://api.dexscreener.com/latest

# --- Ingestion tuning ---
POLL_INTERVAL_SECONDS=30
TRACKED_CHAINS=solana,bsc,ethereum
MIN_LIQUIDITY_USD=20000

# --- API ---
API_PORT=8000
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=http://localhost:8080

# --- Scoring weights (must sum to 1.0) ---
WEIGHT_VOLATILITY=0.4
WEIGHT_MOMENTUM=0.4
WEIGHT_LIQUIDITY=0.2
